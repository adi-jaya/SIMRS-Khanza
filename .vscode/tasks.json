{
  "version": "2.0.0",
  "osx": {
    "options": {
      "env": {
        "JAVA_HOME": "/Library/Java/JavaVirtualMachines/temurin-8.jdk/Contents/Home",
        "ANT_OPTS": "-Xss64m -Xmx2048m"
      }
    }
  },
  "windows": {
    "options": {
      "env": {
        "JAVA_HOME": "C:\\Program Files\\BellSoft\\LibericaJDK-15-Full",
        "PATH": "C:\\Program Files\\BellSoft\\LibericaJDK-15-Full\\bin;${env:PATH}",
        "ANT_OPTS": "-Xss64m -Xmx2048m"
      }
    }
  },
  "linux": {
    "options": {
      "env": {
        "ANT_OPTS": "-Xss64m -Xmx2048m"
      }
    }
  },
  "tasks": [
    {
      "label": "Ant: Clean & Build JAR",
      "type": "shell",
      "command": "ant clean jar",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$javac"]
    },
    {
      "label": "Ant: Compile",
      "type": "shell",
      "command": "ant compile",
      "group": "none",
      "problemMatcher": ["$javac"]
    },
    {
      "label": "Ant: Run",
      "type": "shell",
      "command": "ant run",
      "group": "none",
      "problemMatcher": ["$javac"]
    }
  ]
}
